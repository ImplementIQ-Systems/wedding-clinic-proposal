# Local dev (SQLite — compatível com MySQL em produção)
DATABASE_URL=sqlite:///./wedding_clinic.db

# Produção MySQL
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/wedding_clinic

# Gera um segredo forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-use-a-real-secret-in-production

DEBUG=True
UPLOAD_DIR=uploads
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
